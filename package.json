{
  "name": "workwithserver",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "cd client && npm install --include=dev",
    "dev": "node -e \"if(!require('fs').existsSync('client/dist/index.html'))require('child_process').execSync('npm run build',{stdio:'inherit'})\" && node server/server.cjs",
    "build": "cd client && npm run build",
    "start": "npm run build && node server/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0"
  }
}
